# Multi-stage build: Frontend build
FROM node:20-alpine AS frontend-builder

WORKDIR /app

# Copy frontend files
COPY package.json package-lock.json ./
RUN npm ci

COPY vite.config.ts tsconfig.json ./
COPY resources ./resources
COPY . .

# Build Vite assets for production
RUN DOCKER_BUILD=1 npm run build

# Multi-stage build: PHP application
FROM php:8.4-fpm-alpine

ARG PHPREDIS_VERSION=6.2.0

# Install system dependencies
RUN apk add --no-cache \
    curl \
    git \
    postgresql-client \
    libpq-dev \
    bash \
    nginx \
    supervisor \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS \
    && mkdir -p /usr/src/php/ext/redis \
    && curl -fsSL "https://github.com/phpredis/phpredis/archive/refs/tags/${PHPREDIS_VERSION}.tar.gz" -o /tmp/phpredis.tar.gz \
    && tar -xzf /tmp/phpredis.tar.gz -C /usr/src/php/ext/redis --strip-components=1 \
    && docker-php-ext-install redis pdo pdo_pgsql \
    && rm -f /tmp/phpredis.tar.gz \
    && apk del .build-deps

# Image codecs used by avatar uploads and listing preview generation.
RUN apk add --no-cache libpng libjpeg-turbo libwebp freetype \
    && apk add --no-cache --virtual .gd-build-deps $PHPIZE_DEPS libpng-dev libjpeg-turbo-dev libwebp-dev freetype-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp --with-freetype \
    && docker-php-ext-install gd \
    && apk del .gd-build-deps

RUN { \
    echo "upload_max_filesize=8M"; \
    echo "post_max_size=40M"; \
    echo "memory_limit=256M"; \
    echo "short_open_tag=Off"; \
    } > /usr/local/etc/php/conf.d/uploads.ini

# Install Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

WORKDIR /var/www/html

# Copy application files
COPY --chown=www-data:www-data . .
RUN php scripts/verify-image-runtime.php

# Copy built frontend assets from builder stage
COPY --chown=www-data:www-data --from=frontend-builder /app/public/build ./public/build

# Local container builds include the locked test tools.
ARG INSTALL_DEV_DEPENDENCIES=false
RUN if [ "$INSTALL_DEV_DEPENDENCIES" = "true" ]; then \
        composer install --no-interaction --prefer-dist --optimize-autoloader; \
    else \
        composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader; \
    fi

# Create necessary directories and set permissions
RUN mkdir -p storage/logs storage/app bootstrap/cache \
    /var/log/supervisor \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Copy Nginx configuration
COPY docker/nginx/default.conf /etc/nginx/http.d/default.conf

# Copy Supervisor configuration
COPY docker/supervisor/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Copy entrypoint script
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
